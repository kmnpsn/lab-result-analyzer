{
  "name": "lab-result-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:web": "ng build --configuration production",
    "build": "npm run build:web",
    "dev:worker": "node scripts/run-wrangler.mjs dev",
    "cf:config": "bash scripts/set-cloudflare-config.sh",
    "cf:oauth": "bash scripts/setup-google-oauth.sh",
    "db:migrate:local": "node scripts/run-wrangler.mjs d1 migrations apply lab-result-db --local",
    "db:migrate:remote": "node scripts/run-wrangler.mjs d1 migrations apply lab-result-db --remote",
    "deploy": "npm run build:web && node scripts/run-wrangler.mjs deploy",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.13.0",
    "typescript": "~5.7.2",
    "wrangler": "^4.4.0"
  }
}
